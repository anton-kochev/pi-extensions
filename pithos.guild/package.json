{
  "name": "@pithos-kit/guild",
  "version": "0.2.0",
  "description": "Software-development Guild members and TDD guidance for .NET, Angular, TypeScript, Rust, and language-agnostic code review.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pithos",
    "guild",
    "delegation",
    "dotnet",
    "angular",
    "typescript",
    "javascript",
    "rust",
    "code-review",
    "tdd",
    "test-driven-development"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anton-kochev/pithos-kit.git",
    "directory": "pithos.guild"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pithosKit": {
    "displayName": "Guild",
    "summary": "Delegate focused architecture, implementation, and code review to isolated members with TDD guidance.",
    "minimumPi": ">=0.83.0",
    "commands": [
      { "name": "guild", "usage": "/guild [--help]", "summary": "List the active Guild roster." },
      { "name": "guild-handover", "usage": "/guild-handover [member] [task]", "summary": "Delegate directly from the interactive TUI." },
      { "name": "skill:tdd", "usage": "/skill:tdd [task context]", "summary": "Load the test-driven development workflow explicitly." }
    ],
    "tools": [
      { "name": "guild_handover", "summary": "Hand focused work to an isolated Guild member." }
    ],
    "prompts": [],
    "skills": [
      { "name": "tdd", "summary": "Test-driven development through red-green-refactor." }
    ],
    "themes": [],
    "agents": [
      { "name": "dotnet-architect", "summary": "Read-only .NET architecture and review." },
      { "name": "frontend-architect", "summary": "Read-only front-end architecture and review." },
      { "name": "csharp-coder", "summary": "Scoped C# and .NET implementation." },
      { "name": "angular-coder", "summary": "Scoped Angular implementation." },
      { "name": "typescript-coder", "summary": "Scoped TypeScript and JavaScript implementation." },
      { "name": "rust-coder", "summary": "Scoped Rust implementation." },
      { "name": "rust-architect", "summary": "Read-only Rust architecture and structural review." },
      { "name": "code-reviewer", "summary": "Read-only language-agnostic code review." }
    ],
    "configuration": [
      { "kind": "directory", "key": ".pi/agents", "summary": "Trusted project Guild member overrides." },
      { "kind": "directory", "key": "~/.pi/agent/agents", "summary": "User Guild member overrides." }
    ]
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "agents",
    "extensions",
    "skills",
    "src",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  }
}
