{
  "name": "@pithos-kit/guild",
  "version": "0.1.0",
  "description": "Standalone .NET and Angular Guild members for Pi.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pithos",
    "guild",
    "delegation",
    "dotnet",
    "angular"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anton-kochev/pithos-kit.git",
    "directory": "pithos.guild"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pithosKit": {
    "displayName": "Guild",
    "summary": "Delegate focused .NET and Angular work to isolated architecture and implementation members.",
    "minimumPi": ">=0.83.0",
    "commands": [
      { "name": "guild", "usage": "/guild [--help]", "summary": "List the active Guild roster." },
      { "name": "guild-handover", "usage": "/guild-handover [member] [task]", "summary": "Delegate directly from the interactive TUI." }
    ],
    "tools": [
      { "name": "guild_handover", "summary": "Hand focused work to an isolated Guild member." }
    ],
    "prompts": [],
    "skills": [],
    "themes": [],
    "agents": [
      { "name": "dotnet-architect", "summary": "Read-only .NET architecture and review." },
      { "name": "frontend-architect", "summary": "Read-only front-end architecture and review." },
      { "name": "csharp-coder", "summary": "Scoped C# and .NET implementation." },
      { "name": "angular-coder", "summary": "Scoped Angular implementation." }
    ],
    "configuration": [
      { "kind": "directory", "key": ".pi/agents", "summary": "Trusted project Guild member overrides." },
      { "kind": "directory", "key": "~/.pi/agent/agents", "summary": "User Guild member overrides." }
    ]
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "agents",
    "extensions",
    "src",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  }
}
