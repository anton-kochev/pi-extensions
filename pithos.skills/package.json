{
  "name": "@pithos-kit/skills",
  "version": "0.3.2",
  "description": "Anton Kochev's Pi skills and prompt commands.",
  "keywords": [
    "pi-package",
    "pi-prompt-template",
    "pi-skill",
    "pithos",
    "plan-mode",
    "planning",
    "tdd",
    "test-driven-development",
    "srs",
    "requirements",
    "iso-29148",
    "ears"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anton-kochev/pithos-kit.git",
    "directory": "pithos.skills"
  },
  "publishConfig": {
    "access": "public"
  },
  "pithosKit": {
    "displayName": "Skills",
    "summary": "Provide enforced planning, commit and SRS prompts, a Plan theme, and TDD guidance.",
    "minimumPi": ">=0.83.0",
    "commands": [
      { "name": "plan", "usage": "/plan <task>", "summary": "Enter an enforced read-only planning workflow." },
      { "name": "commit", "usage": "/commit [instructions]", "summary": "Create a relevant Conventional Commit." },
      { "name": "srs", "usage": "/srs <request>", "summary": "Create an approved ISO 29148-style SRS." },
      { "name": "skill:tdd", "usage": "/skill:tdd [task context]", "summary": "Load the bundled TDD workflow explicitly." }
    ],
    "tools": [
      { "name": "create_plan", "summary": "Internal controlled plan writer, active only during Plan mode.", "internal": true }
    ],
    "prompts": [
      { "name": "plan", "summary": "Enforced read-only planning workflow." },
      { "name": "commit", "summary": "Conventional Commit workflow." },
      { "name": "srs-generator", "summary": "ISO 29148-style SRS workflow." }
    ],
    "skills": [
      { "name": "tdd", "summary": "Test-driven development through red-green-refactor." }
    ],
    "themes": [
      { "name": "plan", "summary": "Minimal planning-state theme." }
    ],
    "agents": [],
    "configuration": [
      { "kind": "directory", "key": ".pi/plans", "summary": "Approved generated implementation plans." }
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/plan-theme.ts"
    ],
    "prompts": [
      "./prompts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "files": [
    "extensions",
    "prompts",
    "skills",
    "themes",
    "README.md"
  ]
}
