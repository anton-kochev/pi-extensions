    {
      "name": "@pithos-kit/skills",
      "version": "0.3.2",
      "description": "Anton Kochev's Pi skills and prompt commands.",
      "pi": {
        "extensions": [
          "./extensions/plan-theme.ts"
        ],
        "prompts": [
          "./prompts"
        ],
        "skills": [
          "./skills"
        ],
        "themes": [
          "./themes"
        ]
      },
      "pithosKit": {
        "displayName": "Skills",
        "summary": "Provide enforced planning, commit and SRS prompts, a Plan theme, and TDD guidance.",
        "minimumPi": ">=0.83.0",
        "commands": [
          {
            "name": "plan",
            "summary": "Enter an enforced read-only planning workflow.",
            "usage": "/plan <task>"
          },
          {
            "name": "commit",
            "summary": "Create a relevant Conventional Commit.",
            "usage": "/commit [instructions]"
          },
          {
            "name": "srs",
            "summary": "Create an approved ISO 29148-style SRS.",
            "usage": "/srs <request>"
          },
          {
            "name": "skill:tdd",
            "summary": "Load the bundled TDD workflow explicitly.",
            "usage": "/skill:tdd [task context]"
          }
        ],
        "tools": [
          {
            "name": "create_plan",
            "summary": "Internal controlled plan writer, active only during Plan mode.",
            "internal": true
          }
        ],
        "prompts": [
          {
            "name": "plan",
            "summary": "Enforced read-only planning workflow."
          },
          {
            "name": "commit",
            "summary": "Conventional Commit workflow."
          },
          {
            "name": "srs-generator",
            "summary": "ISO 29148-style SRS workflow."
          }
        ],
        "skills": [
          {
            "name": "tdd",
            "summary": "Test-driven development through red-green-refactor."
          }
        ],
        "themes": [
          {
            "name": "plan",
            "summary": "Minimal planning-state theme."
          }
        ],
        "agents": [],
        "configuration": [
          {
            "kind": "directory",
            "key": ".pi/plans",
            "summary": "Approved generated implementation plans."
          }
        ]
      }
    },
    {
      "name": "@pithos-kit/squiggle",
      "version": "0.4.0",
